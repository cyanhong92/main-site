---
import '../styles/global.css';
const { title } = Astro.props;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar">
      <a href="/" class="name">Cyan Hong</a>
      <nav>
        <a href="/about">About</a>
        <a href="/cv">CV</a>
        <a href="/projects">Projects</a>
      </nav>
      <footer class="copyright">© {new Date().getFullYear()} Seoyeon Hong</footer>
    </aside>
    <main class="content">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: 200px 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 32px 24px;
    border-right: 1px solid #ddd;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .content {
    padding: 32px;
  }

  .content > :global(:first-child) {
    margin-top: 0;
  }

  .copyright {
    margin-top: auto;
    font-size: 12px;
    color: #888;
  }

  .name {
    font-size: 20px;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .sidebar {
      position: sticky;
      top: 0;
      z-index: 10;
      height: auto;
      padding: 16px 20px;
      gap: 12px;
      border-right: none;
      border-bottom: 1px solid #ddd;
      background: #fff;
    }
    .sidebar nav {
      flex-direction: row;
      gap: 20px;
    }
    .copyright {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 10;
      margin-top: 0;
      padding: 8px 20px;
      background: #fff;
      border-top: 1px solid #ddd;
    }
    .content {
      padding: 20px 20px 56px;
    }
  }
</style>