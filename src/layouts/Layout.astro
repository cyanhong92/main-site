---
import '../styles/global.css';
const { title, lang = 'ko' } = Astro.props;
const path = Astro.url.pathname;
const prefix = lang === 'en' ? '/en' : '';
// 언어 전환 버튼이 갈 주소: 같은 페이지의 다른 언어 버전
const altPath = lang === 'en'
  ? (path.replace(/^\/en/, '') || '/')
  : '/en' + path;
const menu = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/cv', label: 'CV' },
];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar">
      <div class="top">
        <a href={prefix + '/'} class="name">{lang === 'en' ? 'Cyan Hong' : '홍서연'}</a>
        {lang === 'en'
          ? <a href={altPath} class="lang-toggle to-kr" hreflang="ko">KR</a>
          : <a href={altPath} class="lang-toggle to-en" hreflang="en">EN</a>}
      </div>
      <div class="menu-row">
        <nav>
          {menu.map((item) => (
            <a href={prefix + item.href} class:list={[{ active: path.startsWith(prefix + item.href) }]}>
              {item.label}
            </a>
          ))}
        </nav>
        <a href="https://www.instagram.com/cyan.hong/" class="insta" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="2.5 2.5 19 19" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.13" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
      <footer class="copyright">© {new Date().getFullYear()} Cyan Hong</footer>
    </aside>
    <main class="content">
      <slot />
    </main>
    <script>
      // 링크에 마우스를 올릴 때마다 무작위 색. 채도·밝기는 고정해서 글자가 잘 보이게 함
      document.querySelectorAll('a:not(.lang-toggle)').forEach((a) => {
        a.addEventListener('mouseenter', () => {
          a.style.color = `hsl(${Math.floor(Math.random() * 360)}, 90%, 50%)`;
        });
        a.addEventListener('mouseleave', () => {
          a.style.color = '';
        });
      });
    </script>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 22px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .sidebar::after {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    right: 0;
    width: 1px;
    background: #ddd;
  }

  .sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar nav a {
    width: fit-content;
    padding: 4px 10px;
    margin-left: -10px;
    border-radius: 999px;
  }

  .sidebar nav a.active {
    background: radial-gradient(50% 50% at 50% 50%, #f2a1ff 0%, #f2a1ff 20%, #00ffff 90%);
  }

  .content {
    padding: 25px 32px 32px;
  }

  .content > :global(:first-child) {
    margin-top: 0;
  }

  /* 웹: menu-row 상자를 없는 것처럼 처리해서 nav와 insta가 sidebar의 직접 자식처럼 배치됨 */
  .menu-row {
    display: contents;
  }

  .insta {
    margin-top: auto;
    margin-bottom: 1px; /* 시각 보정 */
    width: fit-content;
    display: flex;
  }

  .copyright {
    margin-top: -20px;
    font-size: 12px;
    color: #888;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .lang-toggle {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 1;
    border: 1.25px solid #111;
    border-radius: 50%;
  }

  .lang-toggle.to-en,
  .lang-toggle.to-en:hover {
    background: #111;
    color: #fff;
  }

  .lang-toggle.to-kr,
  .lang-toggle.to-kr:hover {
    background: #fff;
    color: #111;
  }

  .name {
    white-space: nowrap;
    font-size: 22px;
    margin-left: -2px;
    line-height: 26px;
  }

  @media (max-width: 720px) {
    body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .sidebar {
      position: sticky;
      top: 0;
      z-index: 10;
      height: auto;
      padding: 16px 20px 8px;
      gap: 18px;
      background: #fff;
    }
    .sidebar::after {
      top: auto;
      bottom: 0;
      left: 10px;
      right: 10px;
      width: auto;
      height: 1px;
    }
    .sidebar nav {
      flex-direction: row;
      gap: 20px;
    }
    /* 모바일: nav와 insta를 한 줄에, insta는 오른쪽 끝 (언어 버튼 아래) */
    .menu-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .insta {
      margin-top: 0;
      width: 24px;
      justify-content: center;
    }
    .copyright {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 10;
      margin-top: 0;
      padding: 8px 20px;
      background: #fff;
    }
    .copyright::before {
      content: '';
      position: absolute;
      top: 0;
      left: 10px;
      right: 10px;
      height: 1px;
      background: #ddd;
    }
    .content {
      padding: 20px 20px 56px;
    }
  }
</style>