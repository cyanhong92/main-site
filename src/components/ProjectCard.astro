---
// 카드 하나. 목록(ProjectsPage)과 상세 페이지 오른쪽 목록(ProjectDetail)에서 같이 씀
// p: getProjects()가 돌려준 항목 하나
import { Image } from 'astro:assets';
const { p, lang = 'ko', active = false } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---
<a href={`${prefix}/projects/${p.slug}`} class:list={['card', { active }]}>
  <div class="thumb">
    {p.cover && <Image src={p.cover} alt={p.title} width={800} />}
  </div>
  <p class="title"><span>{p.title}</span></p>
  <p class="year">{p.year}</p>
</a>

<style>
  .card {
    display: block;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .title,
  .year {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .title {
    margin-top: 12px;
  }

  .year {
    color: #888;
  }

  /* 지금 보고 있는 작품: 회색 라운드 박스 (CV 고정 항목과 같은 색) */
  .active .title span {
    padding: 2px 8px;
    margin-left: -8px;
    border-radius: 999px;
    background: #ededed;
  }
</style>
