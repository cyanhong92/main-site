---
import '../styles/global.css';
const { title } = Astro.props;
const path = Astro.url.pathname;
const menu = [
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/projects', label: 'Projects' },
];
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar">
      <a href="/" class="name">Cyan Hong</a>
      <nav>
        {menu.map((item) => (
          <a href={item.href} class:list={[{ active: path.startsWith(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
      <footer class="copyright">© {new Date().getFullYear()} Cyan Hong</footer>
    </aside>
    <main class="content">
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: 200px 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 22px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .sidebar::after {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    right: 0;
    width: 1px;
    background: #ddd;
  }

  .sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar nav a {
    width: fit-content;
    padding: 4px 10px;
    margin-left: -10px;
    border-radius: 999px;
  }

  .sidebar nav a.active {
    background: #7fffff;
  }

  .content {
    padding: 32px 32px 32px;
  }

  .content > :global(:first-child) {
    margin-top: 0;
  }

  .copyright {
    margin-top: auto;
    font-size: 12px;
    color: #888;
  }

  .name {
    font-size: 22px;
  }

  @media (max-width: 720px) {
    body {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .sidebar {
      position: sticky;
      top: 0;
      z-index: 10;
      height: auto;
      padding: 16px 20px 8px;
      gap: 18px;
      background: #fff;
    }
    .sidebar::after {
      top: auto;
      bottom: 0;
      left: 10px;
      right: 10px;
      width: auto;
      height: 1px;
    }
    .sidebar nav {
      flex-direction: row;
      gap: 20px;
    }
    .copyright {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 10;
      margin-top: 0;
      padding: 8px 20px;
      background: #fff;
    }
    .copyright::before {
      content: '';
      position: absolute;
      top: 0;
      left: 10px;
      right: 10px;
      height: 1px;
      background: #ddd;
    }
    .content {
      padding: 20px 20px 56px;
    }
  }
</style>