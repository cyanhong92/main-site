---
// Projects 목록 화면. lang="ko" 또는 "en"
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import { getProjects } from '../lib/projects.js';
const { lang = 'ko' } = Astro.props;
const projects = await getProjects(lang);
const listHref = `${lang === 'en' ? '/en' : ''}/projects`;

// 썸네일 기울기: 폴더 이름(slug)으로 -3°~3° 사이 값을 계산 → 작품마다 늘 같은 각도
// 새 작품도 자동으로 각도가 정해지고, 따로 적을 것은 없음
function tilt(slug) {
  let h = 0;
  for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return ((h % 61) / 10 - 3).toFixed(1);
}

// 목록 순서대로 보면서 같은 방향이 3개 연속이 되면 그 작품의 방향만 뒤집음 (각도 크기는 그대로)
// → 작품을 새로 넣으면 그 뒤 작품 몇 개의 방향이 바뀔 수 있음
const tilts = [];
for (const p of projects) {
  let t = Number(tilt(p.slug));
  const [a, b] = tilts.slice(-2);
  if (a !== undefined && Math.sign(a) === Math.sign(b) && Math.sign(b) === Math.sign(t)) t = -t;
  tilts.push(t);
}

// 기울인 썸네일이 칸 밖으로 나가 잘리지 않도록 살짝 줄이는 비율 (기울기가 클수록 조금 더 작게)
// 16:9 사진을 각도 a만큼 돌렸을 때 가로 폭이 원래 폭 안에 들어가는 비율
function fit(deg) {
  const a = (Math.abs(deg) * Math.PI) / 180;
  return (1 / (Math.cos(a) + (9 / 16) * Math.sin(a))).toFixed(3);
}
---
<div class="wrap">
  <ul class="grid">
    {projects.map((p, i) => (
      <li class="cell" style={`--tilt: ${tilts[i]}deg; --fit: ${fit(tilts[i])}`}><ProjectCard p={p} lang={lang} /></li>
    ))}
  </ul>
</div>

<!-- 모바일 팝업: 카드를 누르면 페이지를 옮기지 않고 이 위에 상세 내용을 불러와 띄움 -->
<ProjectModal closeHref={listHref} />

<script>
  import { setupProjectModal } from '../lib/project-modal.js';

  // 카드 클릭: 모바일은 팝업, 웹은 상세 페이지로 이동 (돌아올 때 보던 위치로 복원하도록 기억)
  setupProjectModal(document.querySelectorAll('.grid .card'), {
    onDesktopClick: () => {
      sessionStorage.setItem('projectsList', JSON.stringify({
        path: location.pathname,
        y: window.scrollY,
      }));
    },
  });

  // 웹: 상세에서 '<'로 돌아온 경우 원래 위치로
  const saved = JSON.parse(sessionStorage.getItem('projectsList') || 'null');
  if (sessionStorage.getItem('projectsListRestore') && saved && saved.path === location.pathname) {
    window.scrollTo(0, saved.y);
  }
  sessionStorage.removeItem('projectsListRestore');
</script>

<style>
  /* 이 화면에서만 쓰는 값 */
  .wrap {
    --cell-pad: 16px; /* 카드와 그리드 선 사이 여백 */
  }

  /* 칸마다 오른쪽·아래 선을 긋고, 바깥쪽 선과 여백은 wrap 밖으로 밀어내 잘라냄
     → 카드 사이에만 선이 남고, 이미지 가장자리는 본문 가장자리에 맞춰짐 */
  .wrap {
    overflow: hidden;
    margin: 0 var(--projects-inset);
    /* + 8px: 첫 줄 썸네일의 기울어진 위쪽 모서리가 잘리지 않게 */
    padding-top: calc(var(--projects-nudge) + 8px);
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* 위·왼쪽은 여백만큼, 오른쪽·아래는 여백 + 선 1px만큼 밖으로 */
    margin: calc(-1 * var(--cell-pad)) calc(-1 * var(--cell-pad) - 1px) calc(-1 * var(--cell-pad) - 1px) calc(-1 * var(--cell-pad));
  }

  .cell {
    padding: var(--cell-pad);
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }

  /* 썸네일 기울기 (값은 위의 tilt()가 작품마다 정함) */
  .grid :global(.thumb) {
    transform: rotate(var(--tilt, 0deg)) scale(var(--fit, 1));
  }

  /* 마지막 카드 오른쪽은 늘 바깥이거나 빈 칸이라 선을 지움 */
  .cell:last-child {
    border-right-color: transparent;
  }

  /* 아주 넓은 화면: 4열 */
  @media (min-width: 1600px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* 좁은 노트북·태블릿: 2열 */
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 모바일: 1장씩, 추가 여백 없음. 팝업 모양은 src/styles/project-modal.css */
  @media (max-width: 720px) {
    .wrap {
      margin: 0;
      padding-top: 8px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
