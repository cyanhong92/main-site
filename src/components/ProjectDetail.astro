---
// 프로젝트 상세 화면
// 웹: 왼쪽 2칸 너비에 내용, 오른쪽 1칸에 목록 (지금 작품이 보이게 스크롤)
// 모바일: 목록 위에 배경 + 팝업, 오른쪽 위 X로 닫기
//   (목록에서 카드를 누르면 ProjectsPage가 같은 페이지 위에 팝업을 띄움.
//    이 페이지는 주소로 바로 들어온 경우에 보임)
import { Image } from 'astro:assets';
import ProjectCard from './ProjectCard.astro';
import { render } from 'astro:content';
import { getProjects } from '../lib/projects.js';
import '../styles/project-article.css';
import '../styles/project-modal.css';
const { p, lang = 'ko' } = Astro.props;
const projects = await getProjects(lang);
const { Content } = await render(p.entry); // 마크다운 본문
const prefix = lang === 'en' ? '/en' : '';
const listHref = `${prefix}/projects`;
---
<div class="detail-layout">
  <div class="main pm-overlay">
    <a href={listHref} class="pm-backdrop" aria-label="Close"></a>
    <a href={listHref} class="pm-close" aria-label="Close"><svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" /></svg></a>
    <a href={listHref} class="back" aria-label="Back"><svg viewBox="0 0 10 16" width="10" height="16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M8.5 1 L1.5 8 L8.5 15" /></svg></a>
    <article class="pm-panel project-article">
      <div class="hero">
        {(p.coverMotion ?? p.cover) && <Image src={p.coverMotion ?? p.cover} alt={p.title} width={1600} />}
      </div>
      <h1 class="title">{p.title}</h1>
      <p class="year">{p.meta}</p>
      <div class="body">
        <Content />
      </div>
    </article>
  </div>

  <aside class="side">
    <ul class="list">
      {projects.map((item) => (
        <li class="cell">
          <ProjectCard p={item} lang={lang} active={item.slug === p.slug} />
        </li>
      ))}
    </ul>
  </aside>
</div>

<script>
  import { isMobile } from '../lib/breakpoints.js';

  // 웹: 오른쪽 목록에서 지금 작품 카드가 가운데 보이도록 스크롤
  const active = document.querySelector('.side .active');
  const side = document.querySelector('.side');
  if (active && side && !isMobile()) {
    side.scrollTop = active.parentElement.offsetTop - side.clientHeight / 2 + active.clientHeight / 2;
  }

  // 닫기·뒤로가기: 목록으로 돌아가면 원래 보던 위치로 복원하라고 표시 (ProjectsPage 참고)
  const markRestore = () => sessionStorage.setItem('projectsListRestore', '1');
  document.querySelectorAll('.pm-close, .pm-backdrop, .back').forEach((el) => el.addEventListener('click', markRestore));

  // Esc로 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      markRestore();
      location.href = document.querySelector('.back').getAttribute('href');
    }
  });
</script>

<style>
  /* 이 화면에서만 쓰는 값 */
  .detail-layout {
    --back-gutter: 22px;  /* '<' 버튼이 들어가는 사진 왼쪽 공간 */
    --list-indent: 21px;  /* 오른쪽 목록: 세로선에서 카드까지 */
    --cell-pad: 16px;     /* 오른쪽 목록: 카드 사이 위아래 여백 */
  }

  /* ---------- 웹 ---------- */
  @media (min-width: 721px) {
    /* 화면 높이에 딱 맞춤 → 페이지 전체 스크롤 없음. 왼쪽 내용과 오른쪽 목록이 각자 스크롤
       (본문 위·아래 여백과 살짝 내린 만큼을 뺀 높이) */
    .detail-layout {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      height: calc(100vh - var(--content-pt) - var(--content-pb) - var(--projects-nudge));
      margin: 0 var(--projects-inset);
      position: relative;
      top: var(--projects-nudge); /* 첫 요소의 위쪽 margin은 Layout에서 0으로 지워져서 top 사용 */
    }

    .main {
      height: 100%;
      overflow-y: auto;
      padding-right: var(--content-px);
      padding-bottom: 20px; /* 설명이 길어져도 맨 아래 여백 */
      /* '<' 버튼이 잘리지 않게 왼쪽 공간을 스크롤 영역에 포함 */
      margin-left: calc(-1 * var(--back-gutter));
      padding-left: var(--back-gutter);
    }

    /* 사진 왼쪽 바깥, 사진 윗선에 맞춤. 스크롤해도 위에 고정 (sticky)
       아래 margin을 높이만큼 빼서 아래 내용을 밀어내지 않음 */
    .back {
      position: sticky;
      top: 1px;
      z-index: 1;
      display: block;
      width: 10px;
      height: 16px;
      margin: 0 0 -16px calc(-1 * var(--back-gutter));
      color: var(--c-text);
    }

    /* 오른쪽 목록. 왼쪽 세로선은 그리드 선과 같은 색 */
    .side {
      height: 100%;
      overflow-y: auto;
      border-left: 1px solid var(--c-line);
    }

    .cell {
      margin-left: var(--list-indent); /* 가로선이 세로선에 붙지 않게 */
    }

    /* 스크롤은 되지만 스크롤바는 숨김 */
    .main,
    .side {
      scrollbar-width: none;
    }

    .main::-webkit-scrollbar,
    .side::-webkit-scrollbar {
      display: none;
    }
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cell {
    padding-bottom: var(--cell-pad);
  }

  .cell + .cell {
    padding-top: var(--cell-pad);
    border-top: 1px solid var(--c-line);
  }

  /* ---------- 모바일 ----------
     팝업 모양은 src/styles/project-modal.css. 뒤에는 목록이 1장씩 깔림 */
  @media (max-width: 720px) {
    .back {
      display: none;
    }
  }
</style>
